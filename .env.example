# Cal.com — paste Matilda's event link (no API key needed for the embed)
# Examples:
#   matilda-method/clarity-call
#   https://cal.com/matilda-method/clarity-call
NEXT_PUBLIC_CAL_LINK=

# Optional. Only set this if Cal.com is self-hosted or on a custom domain.
# NEXT_PUBLIC_CAL_ORIGIN=https://cal.com

# Stripe — private coaching checkout (£1,497 / 3×£499)
# Get keys from https://dashboard.stripe.com/apikeys (test mode first)
STRIPE_SECRET_KEY=
# Used for success/cancel URLs in production (e.g. https://matildamethod.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
